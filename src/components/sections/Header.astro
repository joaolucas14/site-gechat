---
/* Header fixo do site: logo, navegação e CTAs.
   Ganha fundo de vidro ao rolar; na Sprint 3 passa a ceder o palco
   para a trilha de recursos (classe .is-shed). */
import Logo from '../ui/Logo.astro';
import Btn from '../ui/Btn.astro';
import { LOGIN_LINK, SIGNUP_LINK } from '../../data/links';
import '../../styles/sections/header.css';
---

<header class="site-head">
  <div class="site-head-inner">
    <a class="brand" href="#topo"><Logo loading="eager" fetchpriority="high" /></a>
    <nav class="site-nav">
      <a href="#funcionalidades">Funcionalidades</a>
      <a href="#planos">Preços</a>
    </nav>
    <div class="head-spacer"></div>
    <div class="head-cta">
      <Btn variant="ghost" size="sm" href={LOGIN_LINK}>Entrar</Btn>
      <Btn variant="pri" size="sm" href={SIGNUP_LINK}>Teste 7 dias grátis</Btn>
    </div>
  </div>
</header>

<script>
  // Header ganha o fundo de vidro depois de 24px de rolagem.
  const head = document.querySelector('.site-head');
  if (head) {
    const onScroll = () => head.classList.toggle('scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
