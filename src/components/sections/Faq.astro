---
/* FAQ em acordeão acessível (uma pergunta aberta por vez).
   Conteúdo em data/faqs.ts; respostas sempre presentes no DOM. */
import Icon from '../ui/Icon.astro';
import { FAQS } from '../../data/faqs';
import '../../styles/sections/faq.css';

const assures = [
  { ic: 'check_circle', t: '7 dias grátis pra você ter certeza' },
  { ic: 'card', t: 'Sem cartão de crédito pra começar' },
  { ic: 'heart', t: 'Sem fidelidade ou multas' },
];
---

<section class="faq" id="faq">
  <span class="orb orb-fq" data-parallax="0.045"></span>
  <div class="wrap faq-grid">
    <div class="reveal from-l faq-aside">
      <h2 class="h-display">Ainda com<br /><span class="grad-ink">alguma dúvida?</span></h2>
      <p class="lede">Veja o que as equipes mais perguntam antes de começar.</p>
      <ul class="faq-assure">
        {assures.map((a) => (
          <li><span class="faq-assure-ic"><Icon name={a.ic} /></span>{a.t}</li>
        ))}
      </ul>
    </div>
    <div class="reveal from-r d1 faq-list" data-faq>
      {FAQS.map((item, i) => (
        <div class={'faq-item' + (i === 0 ? ' is-open' : '')}>
          <button type="button" class="faq-q" aria-expanded={i === 0 ? 'true' : 'false'}>
            {item.q}
            <span class="faq-chev"><Icon name="arrow_down" /></span>
          </button>
          <div class="faq-a">
            <div class="faq-a-in">
              <p set:html={item.a} />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Acordeão: abre a pergunta clicada e fecha as demais;
  // clicar na aberta fecha tudo (mesmo comportamento do protótipo).
  for (const list of document.querySelectorAll('[data-faq]')) {
    const items = [...list.querySelectorAll<HTMLElement>('.faq-item')];
    for (const item of items) {
      item.querySelector<HTMLButtonElement>('.faq-q')?.addEventListener('click', () => {
        const open = !item.classList.contains('is-open');
        for (const it of items) {
          const on = open && it === item;
          it.classList.toggle('is-open', on);
          it.querySelector('.faq-q')?.setAttribute('aria-expanded', String(on));
        }
      });
    }
  }
</script>
