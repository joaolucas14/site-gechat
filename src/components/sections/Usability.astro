---
/* Seção curta de usabilidade — ponte para os planos. */
import Icon from '../ui/Icon.astro';
import '../../styles/sections/pricing.css';
---

<section class="usa">
  <span class="orb orb-u" data-parallax="0.05"></span>
  <div class="wrap" style="position:relative;z-index:2">
    <div class="sec-head center reveal">
      <span class="eyebrow center"><Icon name="heart" style="width:14px;height:14px" /> Feito pra ser fácil</span>
      <h2 class="h-display">Poderoso pra gestão.<br /><span class="grad-ink">Leve pra quem atende.</span></h2>
      <p class="lede">
        O Gechat foi desenhado para ser simples e agradável:<br />
        a equipe entende em minutos e já começa a atender.
      </p>
      <p class="usa-hook">Fácil de usar, justo no preço. Veja os planos abaixo.</p>
    </div>
  </div>
</section>
