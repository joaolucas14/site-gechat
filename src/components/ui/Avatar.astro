---
/* Avatar circular: foto (otimizada) ou iniciais coloridas —
   mesma paleta e hash de cor do protótipo. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  size?: number;
  fontSize?: number;
  img?: ImageMetadata;
  class?: string;
}

const { name, size = 36, fontSize, img, class: className = '' } = Astro.props;

const AV_COLORS = ['#8B44FF', '#5B6CFF', '#15B36A', '#F59E0B', '#FF6B9D', '#06B6D4', '#7526E8', '#E0497B'];
function avColor(seed: string): string {
  let h = 0;
  for (let i = 0; i < seed.length; i++) h = (h * 31 + seed.charCodeAt(i)) >>> 0;
  return AV_COLORS[h % AV_COLORS.length]!;
}

const initials = name
  .trim()
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase();

const style = [
  `width:${size}px`,
  `height:${size}px`,
  `font-size:${fontSize ?? size * 0.4}px`,
  'overflow:hidden',
  `background:${img ? 'var(--line)' : avColor(name)}`,
].join(';');
---

<span class={('avi ' + className).trim()} style={style}>
  {
    img ? (
      <Image
        src={img}
        alt={name}
        width={size * 2}
        height={size * 2}
        style="width:100%;height:100%;object-fit:cover;border-radius:inherit;display:block"
        draggable="false"
      />
    ) : (
      initials
    )
  }
</span>
