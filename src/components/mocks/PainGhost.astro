---
/* Cena 1 da dor: o atendente saiu da empresa e o histórico foi junto.
   Passos (1300ms, pausa 2400ms no fim): flag "saiu" → conteúdo
   embaça + cadeado → veredito. */
import Avatar from '../ui/Avatar.astro';
import Icon from '../ui/Icon.astro';
import homem2 from '../../assets/avatars/homem-2.png';
---

<div class="pain-mock pg" data-step-mock data-steps="4" data-interval="1300" data-hold="2400" aria-hidden="true">
  <div class="pain-scene">
    <div class="pg-card">
      <div class="pg-content" data-step-in="2">
        <div class="pg-agent">
          <Avatar name="Carlos Vendedor" img={homem2} size={28} />
          <div>
            <div class="pg-nm">Carlos (Vendas)</div>
            <div class="pg-sub">3 anos de conversas</div>
          </div>
        </div>
        <div class="pg-line"></div>
        <div class="pg-line"></div>
        <div class="pg-line"></div>
      </div>
      <span class="pg-flag" data-step-in="1" data-step-in-eq="1">Saiu da empresa</span>
      <span class="pg-lock" data-step-in="2"><Icon name="lock" /></span>
    </div>
    <div class="pain-verdict-line beat" data-step-in="3">
      <Icon name="ghost" /> Histórico saiu junto com ele
    </div>
  </div>
</div>

<script>
  import '../../scripts/step-mock';
</script>
