---
/* Header das páginas da Central da API oficial: mesmo visual do site,
   mas com navegação de volta pra home (que vive em outra rota). */
import Logo from '../ui/Logo.astro';
import Btn from '../ui/Btn.astro';
import { LOGIN_LINK, SIGNUP_LINK } from '../../data/links';
import '../../styles/sections/header.css';
---

<header class="site-head">
  <div class="site-head-inner">
    <a class="brand" href="/"><Logo loading="eager" fetchpriority="high" /></a>
    <nav class="site-nav">
      <a href="/">Conheça o Gechat</a>
      <a href="/#planos">Preços</a>
    </nav>
    <div class="head-spacer"></div>
    <div class="head-cta">
      <Btn variant="ghost" size="sm" href={LOGIN_LINK}>Entrar</Btn>
      <Btn variant="pri" size="sm" href={SIGNUP_LINK} onclick="fbq('track', 'Lead');">Teste 7 dias grátis</Btn>
    </div>
  </div>
</header>

<script>
  // Header ganha o fundo de vidro depois de 24px de rolagem.
  const head = document.querySelector('.site-head');
  if (head) {
    const onScroll = () => head.classList.toggle('scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
