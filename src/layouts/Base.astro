---
/* Layout base: head completo (SEO, fontes self-hosted, estilos globais)
   e scripts de animação usados por todas as seções. */
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/mocks.css';

import WaFloat from '../components/ui/WaFloat.astro';

import jakarta400 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-400-normal.woff2?url';
import jakarta700 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-700-normal.woff2?url';
import poppins800 from '@fontsource/poppins/files/poppins-latin-800-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** og:type — "article" nas páginas da Central da API oficial */
  ogType?: 'website' | 'article';
}

const {
  title = 'Gechat — o WhatsApp da sua empresa, organizado',
  description = 'O Gechat reúne os WhatsApps da sua empresa numa central única: filas por setor, transferências, histórico completo e métricas. Teste 7 dias grátis.',
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-10963772544"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-10963772544');
    </script>
    <!-- Meta Pixel Code -->
    <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1511885044042100');
    fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=1511885044042100&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#FBFAFF" />

    <link rel="preload" as="font" type="font/woff2" href={jakarta400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={jakarta700} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={poppins800} crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Gechat" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gechat — o WhatsApp da sua empresa, organizado" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />

    <!-- sem JS, todo o conteúdo fica visível e o FAQ abre inteiro -->
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; }
        .faq-a { grid-template-rows: 1fr !important; }
      </style>
    </noscript>
  </head>
  <body>
    <div class="site">
      <slot />
    </div>
    <WaFloat />
    <script>
      import '../scripts/reveal';
      import '../scripts/parallax';
    </script>
  </body>
</html>
